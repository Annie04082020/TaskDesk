<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_capture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_rounded"
    android:padding="10dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="＋"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/widget_btn_bg"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快速記錄任務 / 閃念"
            android:textColor="#f0f3f8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="點擊即刻捕捉至收集箱"
            android:textColor="#7a8499"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
