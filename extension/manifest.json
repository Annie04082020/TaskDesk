{
  "manifest_version": 3,
  "name": "TaskDesk Focus Guardian",
  "version": "1.0.0",
  "description": "TaskDesk 專注守護夥伴：在深度工作期間主動攔截 YouTube 與社群等分心網站，支援背景穩定計時與無痛切換。",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TaskDesk 專注守護者",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
